# ==============================================================================
# SECURITY — MUST SET BEFORE GOING LIVE
# ==============================================================================

# 🔒 JWT Secret Key — Generate a strong random key, DO NOT use the default!
# To generate one, run in terminal:  python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=""

# 🔒 Allowed Frontend Origins — comma-separated, NO trailing slash, exact URLs only
# Example for Firebase:
# ALLOWED_ORIGINS=https://your-app-name.web.app,https://your-app-name.firebaseapp.com
# Example for local dev only:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==============================================================================
# DATABASE
# ==============================================================================

# Supabase / PostgreSQL Connection URL
# E.g., postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=""

# ==============================================================================
# AI / EXTERNAL SERVICES
# ==============================================================================

# Groq AI Token (for AI-powered draft generation)
GROQ_API_KEY=""
